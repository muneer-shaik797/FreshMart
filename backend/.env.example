# MongoDB local example. Replace with your own Atlas URI for cloud database.
MONGODB_URI=mongodb://localhost:27017/freshmart

# Generate a long random secret; never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Razorpay TEST credentials from your Razorpay dashboard.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_MOCK_MODE=false

# SMTP example (Gmail requires an App Password, not your normal password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-sender@gmail.com
